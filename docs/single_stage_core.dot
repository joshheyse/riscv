digraph single_stage_core {
  graph [
    rankdir=LR,
    bgcolor="white",
    pad="0.25",
    nodesep="0.55",
    ranksep="0.8",
    splines=ortho,
    fontname="Helvetica",
    label="Single-stage RV32I core",
    labelloc=t,
    fontsize=22
  ];

  node [
    shape=record,
    style="rounded,filled",
    fillcolor="#f8fafc",
    color="#334155",
    penwidth=1.4,
    fontname="Helvetica",
    fontsize=12
  ];

  edge [
    color="#475569",
    penwidth=1.2,
    arrowsize=0.8,
    fontname="Helvetica",
    fontsize=10
  ];

  subgraph cluster_core {
    label="core.sv";
    color="#94a3b8";
    style="rounded,dashed";
    fontname="Helvetica";
    fontsize=14;

    ifu [
      label="{IFU|PC register\lpc+4 / target mux\l|in: clk, rst, pc_src, ieu_addr\lout: pc\l}"
    ];

    imem [
      label="{IMEM|instruction ROM\l$readmemh InitFile\l|in: pc byte addr\lout: instr.raw\l}"
    ];

    controller [
      label="{Controller|main_decoder\lalu_decoder\lbranch_logic\l|in: instr, branch_flags\lout: control bundle, pc_src\l}"
    ];

    datapath [
      label="{Datapath|reg_file\lextend\lALU operand muxes\lALU\lcomparator\lwriteback muxes\l|in: instr, pc, control, read_data\lout: ieu_addr, alu_result, write_data, branch_flags\l}"
    ];

    lsu [
      label="{LSU|word-only data RAM\lcombinational read\lclocked write\l|in: mem_write, alu_result addr, write_data\lout: read_data\l}"
    ];
  }

  clk_rst [
    label="{Board / TB|clk\lrst\l}",
    shape=record,
    fillcolor="#ecfeff",
    color="#0891b2"
  ];

  debug [
    label="{Debug outputs|pc\linstr\l}",
    shape=record,
    fillcolor="#fefce8",
    color="#ca8a04"
  ];

  subgraph cluster_datapath_detail {
    label="datapath.sv detail";
    color="#cbd5e1";
    style="rounded,dotted";
    fontname="Helvetica";
    fontsize=13;

    regfile [
      label="{reg_file|rs1/rs2 reads\lrd writeback\lx0 hard-wired zero\l}",
      fillcolor="#f1f5f9"
    ];

    extend [
      label="{extend|I/S/B/J/U immediates\l}",
      fillcolor="#f1f5f9"
    ];

    alu [
      label="{ALU|add/sub\lshifts\llogic\lcomparisons\l}",
      fillcolor="#f1f5f9"
    ];

    comparator [
      label="{comparator|eq\llt signed/unsigned\l}",
      fillcolor="#f1f5f9"
    ];

    wb_mux [
      label="{writeback mux|ALU result\lPC+4\limmediate\lLSU read_data\l}",
      fillcolor="#f1f5f9"
    ];
  }

  clk_rst -> ifu [label="clk, rst"];
  clk_rst -> datapath [label="clk"];
  clk_rst -> lsu [label="clk"];

  ifu -> imem [label="pc"];
  ifu -> datapath [label="pc"];
  ifu -> debug [label="pc"];

  imem -> controller [label="instr"];
  imem -> datapath [label="instr"];
  imem -> debug [label="instr"];

  controller -> ifu [label="pc_src"];
  controller -> datapath [
    label="reg_write, imm_src,\lalu_src, alu_select,\lsub_arith, writeback controls,\lbranch_sgnd"
  ];
  controller -> lsu [label="mem_write"];

  datapath -> controller [label="branch_flags"];
  datapath -> ifu [label="ieu_addr"];
  datapath -> lsu [label="alu_result addr,\lwrite_data"];
  lsu -> datapath [label="read_data"];

  datapath -> regfile [style=dashed, label="contains"];
  datapath -> extend [style=dashed, label="contains"];
  datapath -> alu [style=dashed, label="contains"];
  datapath -> comparator [style=dashed, label="contains"];
  datapath -> wb_mux [style=dashed, label="contains"];
}
